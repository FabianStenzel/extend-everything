{
  "manifest_version": 3,
  "name": "Bilder in Popup sammeln",
  "version": "1.0",

  "permissions": ["storage"],

  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}
